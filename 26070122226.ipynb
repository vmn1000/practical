   "source": [
    "n = int(input(\"Enter a number\\n\"))\n",
    "fact = 1\n",
    "while(n>0):\n",
    "    fact *= n\n",
    "    n-=1\n",
    "print(\"The factorial of the number is\", fact)"
   ]
